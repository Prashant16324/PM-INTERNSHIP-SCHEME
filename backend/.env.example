# ==============================================================================
# Environment Configuration - PM Internship Scheme Smart Allocation Engine
# NOTE: This is an academic prototype for demonstration and evaluation.
# ==============================================================================

# Application Settings
PROJECT_NAME="AI-Based Smart Allocation Engine for PM Internship Scheme"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (PostgreSQL default, SQLite fallback supported)
# Primary: PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pm_internship_db
# Fallback / Lightweight local development:
# DATABASE_URL=sqlite:///./pm_internship.db

# Security & JWT Configuration
# Generates via: openssl rand -hex 32
SECRET_KEY=pm_internship_super_secret_jwt_key_academic_demo_2026_change_in_prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration (comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Admin Initial Seed Credentials (for bootstrapping local admin)
INITIAL_ADMIN_EMAIL=admin@pm-internship.edu.in
INITIAL_ADMIN_PASSWORD=AdminSecurePass@2026
INITIAL_ADMIN_NAME="System Super Admin"

# File Upload Settings
UPLOAD_DIR="./uploads/resumes"
MAX_UPLOAD_SIZE_MB=5
